{
  "id": "health-dead-context-dialog-classification",
  "description": "Connection loss is DEAD only as the last event; input-bar chrome is ignored, progress is a later event, and context/trust/menu banners classify as Python.",
  "projects": {
    "sandbox": {
      "files": {
        "README.md": "hi\n"
      }
    }
  },
  "home": {
    "config_toml": "[projects.sandbox]\npath = \"{{PROJECT:sandbox}}\"\n"
  },
  "steps": [
    {
      "cwd": "sandbox",
      "argv": [
        "health"
      ],
      "transcript": [
        {
          "match_argv": [
            "agent",
            "list"
          ],
          "reply": {
            "exit": 0,
            "stdout": "{\"result\": {\"agents\": [{\"name\": \"worker\", \"pane_id\": \"w1:p1\", \"cwd\": \"{{PROJECT:sandbox}}\"}]}}"
          }
        },
        {
          "match_argv": [
            "agent",
            "read",
            "w1:p1",
            "--source",
            "visible"
          ],
          "reply": {
            "exit": 0,
            "stdout": "Connection lost\nbypass permissions on (shift+tab to cycle)"
          }
        }
      ],
      "expect": {
        "exit": 3,
        "stdout": "DEAD w1:p1 sandbox \u2014 \u2014\n"
      }
    },
