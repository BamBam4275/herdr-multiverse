{
  "id": "accounts-control-confirmations",
  "description": "Seat controls confirm the resolved account and its new cap or lending state.",
  "dirs": {
    "codex-home": {}
  },
  "projects": {
    "sandbox": {
      "git": true,
      "files": {
        "README.md": "hi\n"
      }
    }
  },
  "home": {
    "config_toml": "[accounts.explorer-seat]\nkind = \"codex\"\nconfig_dir_var = \"CODEX_HOME\"\nconfig_dir = \"{{DIR:codex-home}}\"\npool = \"codex:test\"\n\n[projects.sandbox]\npath = \"{{PROJECT:sandbox}}\"\n"
  },
  "steps": [
    {
      "cwd": "sandbox",
      "argv": [
        "accounts",
        "limit",
        "explorer-seat",
        "1"
      ],
      "transcript": [],
      "expect": {
        "exit": 0,
        "stdout": "explorer-seat: capped at 1 open agent fleet-wide."
      }
    },
    {
      "cwd": "sandbox",
      "argv": [
        "accounts",
        "limit",
        "explorer-seat",
        "3"
      ],
      "transcript": [],
      "expect": {
        "exit": 0,
        "stdout": "explorer-seat: capped at 3 open agents fleet-wide."
      }
    },
    {
      "cwd": "sandbox",
      "argv": [
        "accounts",
        "limit",
        "explorer-seat",
        "--off"
      ],
      "transcript": [],
      "expect": {
        "exit": 0,
        "stdout": "explorer-seat: uncapped."
      }
    },
    {
      "cwd": "sandbox",
      "argv": [
        "accounts",
        "lend",
        "explorer-seat",
        "off"
      ],
      "transcript": [],
      "expect": {
        "exit": 0,
        "stdout": "explorer-seat: not lent \u2014 pulled from every chain until turned back on."
      }
    },
    {
      "cwd": "sandbox",
      "argv": [
        "accounts",
        "lend",
        "explorer-seat",
        "on"
      ],
      "transcript": [],
      "expect": {
        "exit": 0,
        "stdout": "explorer-seat: lent \u2014 back in its chains."
      }
    }
  ]
}
