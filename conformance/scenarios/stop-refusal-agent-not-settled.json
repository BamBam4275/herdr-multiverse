{
  "id": "stop-refusal-agent-not-settled",
  "description": "`stop` refuses to close a workspace while any agent inside it is not done/idle (cli.py's cmd_stop busy/held check), naming the agent's status and pane, exit EXIT_ERROR (1); the workspace_close Herdr call is never issued for a refused label (transcript stops after the three listing calls).",
  "projects": {
    "sandbox": {
      "git": true,
      "files": { "README.md": "hi\n" }
    }
  },
  "home": {
    "config_toml": "[projects.sandbox]\npath = \"{{PROJECT:sandbox}}\"\n"
  },
  "steps": [
    {
      "cwd": "sandbox",
      "argv": ["stop"],
      "transcript": [
        {
          "match_argv": ["workspace", "list"],
          "reply": { "exit": 0, "stdout": "{\"result\": {\"workspaces\": [{\"label\": \"sandbox\", \"workspace_id\": \"ws1\"}]}}\n" }
        },
        {
          "match_argv": ["pane", "list"],
          "reply": { "exit": 0, "stdout": "{\"result\": {\"panes\": [{\"workspace_id\": \"ws1\", \"pane_id\": \"w1:p1\", \"foreground_cwd\": \"{{PROJECT:sandbox}}\"}]}}\n" }
        },
        {
          "match_argv": ["agent", "list"],
          "reply": { "exit": 0, "stdout": "{\"result\": {\"agents\": [{\"workspace_id\": \"ws1\", \"pane_id\": \"w1:p1\", \"agent_status\": \"working\", \"name\": \"fixer-agent\"}]}}\n" }
        }
      ],
      "expect": {
        "exit": 1,
        "stdout": "  sandbox              KEPT — working agent in w1:p1\n\nclosed 0 of 1\n"
      }
    }
  ],
  "expect_tree": [
    { "root": "sandbox", "unchanged": true }
  ]
}
