{
  "id": "check-docker-context",
  "description": "A root Dockerfile without .multiverse exclusion in .dockerignore warrants a build-context warning.",
  "dirs": {
    "codex-home": {}
  },
  "projects": {
    "sandbox": {
      "git": true,
      "files": {
        "README.md": "hi\n",
        "Dockerfile": "FROM scratch\nCOPY . /app\n"
      }
    }
  },
  "home": {
    "config_toml": "[accounts.explorer-seat]\nkind = \"codex\"\nconfig_dir_var = \"CODEX_HOME\"\nconfig_dir = \"{{DIR:codex-home}}\"\npool = \"codex:test\"\n\n[projects.sandbox]\npath = \"{{PROJECT:sandbox}}\"\n"
  },
  "steps": [
    {
      "cwd": "sandbox",
      "argv": [
        "check"
      ],
      "transcript": [],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "without excluding .multiverse in .dockerignore"
        ]
      }
    }
  ],
  "expect_tree": [
    {
      "root": "sandbox",
      "unchanged": true
    }
  ]
}
