{
  "id": "check-verbose-review-policy",
  "description": "Verbose check renders the effective review policy rather than asserting advisory scans are all clear.",
  "dirs": {
    "codex-home": {}
  },
  "projects": {
    "sandbox": {
      "git": true,
      "files": {
        "README.md": "hi\n"
      }
    }
  },
  "home": {
    "config_toml": "[accounts.explorer-seat]\nkind = \"codex\"\nconfig_dir_var = \"CODEX_HOME\"\nconfig_dir = \"{{DIR:codex-home}}\"\npool = \"codex:test\"\n\n[projects.sandbox]\npath = \"{{PROJECT:sandbox}}\"\n"
  },
  "steps": [
    {
      "cwd": "sandbox",
      "argv": [
        "check",
        "--verbose"
      ],
      "transcript": [],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "review policy:",
          "Cross-vendor review required for:"
        ]
      }
    }
  ]
}
