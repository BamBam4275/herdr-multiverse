            "close",
            "ws-beta"
          ],
          "reply": {
            "exit": 0,
            "stdout": "{\"result\": {}}\n"
          }
        }
      ],
      "expect": {
        "exit": 0,
        "stdout": "  beta                 closed (ws-beta)\n\nclosed 1 of 1\n",
        "stderr": ""
      }
    },
    {
