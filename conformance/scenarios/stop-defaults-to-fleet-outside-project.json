            "exit": 0,
            "stdout": "{\"result\": {\"workspaces\": [{\"label\": \"alpha\", \"workspace_id\": \"ws-alpha\"}, {\"label\": \"beta\", \"workspace_id\": \"ws-beta\"}]}}\n"
