            "exit": 0,
            "stdout": "{\"result\":{\"agents\":[]}}\n"
          }
        }
      ],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "removed",
          "reclaimed branch"
        ]
      }
    },
