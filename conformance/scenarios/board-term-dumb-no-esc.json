{
  "id": "board-term-dumb-no-esc",
  "description": "TERM=dumb: the board emits zero ESC bytes, draws ASCII boxes (+ - |) instead of Unicode, and keeps the same visible width. Piped stdout is not a tty, and TERM=dumb is never a confirmed color terminal, so Auto colour stays off.",
  "projects": {
    "sandbox": {
      "git": true,
      "files": {
        "README.md": "hi\n"
      }
    }
  },
  "home": {
    "config_toml": "[projects.sandbox]\npath = \"{{PROJECT:sandbox}}\"\n"
  },
  "steps": [
    {
      "cwd": "sandbox",
      "argv": [
        "backlog",
        "add",
        "fix the thing",
        "--why",
        "it breaks"
      ],
      "transcript": [],
      "expect": {
        "exit": 0
      }
    },
    {
      "cwd": "sandbox",
      "argv": [
        "board",
        "--no-reconcile"
      ],
      "env": {
        "TERM": "dumb"
      },
      "transcript": [
        {
          "match_argv": [
            "agent",
            "list"
          ],
          "reply": {
            "exit": 0,
            "stdout": "{\"result\": {\"agents\": []}}\n"
          }
        }
      ],
      "expect": {
        "exit": 0,
        "stdout": "project: sandbox only (one-project view; --all for the fleet)\n\nsandbox\n+- BLOCKED --------------------------------------------------------------------+\n| (none)                                                                       |\n+------------------------------------------------------------------------------+\n+- IN PROGRESS ----------------------------------------------------------------+\n| (none)                                                                       |\n+------------------------------------------------------------------------------+\n+- BACKLOG --------------------------------------------------------------------+\n| +--------------- <TIME> . <ELAPSED> +                                        |\n| | <ID>                 |                                        |\n| | fix the thing                     |                                        |\n| | P2                                |                                        |\n| +-----------------------------------+                                        |\n+------------------------------------------------------------------------------+\n+- SEATS ----------------+ +- OWED REPLIES (0) -----+ +- MAIL (0) -------------+\n| 0 working              | | (none)                 | | sandbox  0 . offline . |\n| 0 held / 3 cap         | |                        | |                        |\n+------------------------+ +------------------------+ +------------------------+\n+- NEXUS LAST PASS ------+                                                      \n| (none)                 |                                                      \n+------------------------+",
        "stdout_contains": [
          "sandbox",
          "+- BACKLOG",
          "fix the thing"
        ],
        "stdout_not_contains": [
          "\u001b",
          "[92m",
          "[93m",
          "[95m",
          "[96m",
          "[0m",
          "[1;31m"
        ]
      }
    }
  ]
}
