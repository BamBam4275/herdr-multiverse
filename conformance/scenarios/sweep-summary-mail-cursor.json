{
  "id": "sweep-summary-mail-cursor",
  "description": "After a peek leaves mail unacknowledged, sweep reports the mail cursor gap on the recipient summary, before its process warning. Preview and apply both report it without acknowledging mail. Reproduces the additional sweep mismatch in seed 60001.",
  "projects": {
    "sandbox": {
      "git": true,
      "files": {
        "README.md": "hi\n"
      }
    },
    "sandbox2": {
      "git": true,
      "files": {
        "README.md": "hi\n"
      }
    }
  },
  "home": {
    "config_toml": "[projects.sandbox]\npath = \"{{PROJECT:sandbox}}\"\n\n[projects.sandbox2]\npath = \"{{PROJECT:sandbox2}}\"\n\n[activity.pairs]\nsandbox = [\"sandbox2\"]\nsandbox2 = [\"sandbox\"]\n"
  },
  "steps": [
    {
      "cwd": "sandbox",
      "argv": [
        "activity",
        "send",
        "sandbox2",
        "hello there",
        "--id",
        "fixed-msg-1"
      ],
      "transcript": [],
      "expect": {
        "exit": 0,
        "stdout": "sent to sandbox2."
      }
    },
    {
      "cwd": "sandbox2",
      "argv": [
        "activity",
        "inbox",
        "--peek"
      ],
      "transcript": [],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "[<TIMESTAMP>] sandbox: hello there",
          "current through event 1 as of <TIMESTAMP>",
          "last peeked at <TIMESTAMP>, through event 1",
          "sequence numbers are per project and cannot be compared across projects."
        ]
      }
    },
    {
      "cwd": "sandbox",
      "argv": [
        "sweep",
        "--dry-run"
      ],
      "transcript": [
        {
          "match_argv": [
            "agent",
            "list"
          ],
          "reply": {
            "exit": 0,
            "stdout": "{\"result\":{\"agents\":[]}}\n"
          }
        }
      ],
      "env": {
        "MULTIVERSE_DOCKER_BIN": "/usr/bin/false",
        "MULTIVERSE_DF_BIN": "/usr/bin/false",
        "MULTIVERSE_PS_BIN": "/usr/bin/false"
      },
      "expect": {
        "exit": 0,
        "stdout": "sandbox: in progress 0 -> 0, recorded 0, reclaimed 0; warning: process-cwd probe unknown\nsandbox2: in progress 0 -> 0, recorded 0, reclaimed 0; mail cursor behind by 1; warning: process-cwd probe unknown\ndocker: unavailable\n",
        "stderr": ""
      }
    },
    {
      "cwd": "sandbox",
      "argv": [
        "sweep"
      ],
      "transcript": [
        {
          "match_argv": [
            "agent",
            "list"
          ],
          "reply": {
            "exit": 0,
            "stdout": "{\"result\":{\"agents\":[]}}\n"
          }
        }
      ],
      "env": {
        "MULTIVERSE_DOCKER_BIN": "/usr/bin/false",
        "MULTIVERSE_DF_BIN": "/usr/bin/false",
        "MULTIVERSE_PS_BIN": "/usr/bin/false"
      },
      "expect": {
        "exit": 0,
        "stdout": "sandbox: in progress 0 -> 0, recorded 0, reclaimed 0; warning: process-cwd probe unknown\nsandbox2: in progress 0 -> 0, recorded 0, reclaimed 0; mail cursor behind by 1; warning: process-cwd probe unknown\ndocker: unavailable\n",
        "stderr": ""
      }
    }
  ],
  "expect_tree": [
    {
      "root": "sandbox2",
      "files": {
        ".multiverse/routing.log": {
          "regex": "^<TIMESTAMP>\tv=1\tseq=1\tevent=message\tid=fixed-msg-1\tfrom=sandbox\tto=sandbox2\tbody=\"hello there\"\tcrc32=<CRC32>$",
          "mode": 384
        }
      }
    },
    {
      "root": "sandbox",
      "files": {
        ".multiverse/routing.log": {
          "absent": true
        }
      }
    }
  ]
}
